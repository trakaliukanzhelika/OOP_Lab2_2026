<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Lab2.Models"
             x:Class="Lab2.MainPage"
             Title="Кадри науковців (Аналіз штатного розпису)">

    <Grid ColumnDefinitions="340,*" Padding="20" ColumnSpacing="20">

        <!-- Left panel: search parameters -->
        <ScrollView Grid.Column="0">
            <VerticalStackLayout Spacing="10">
                <Button Text="Обрати XML-файл" Clicked="OnChooseFileClicked" />
                <Button Text="Відкрити XML з Google Drive" Clicked="OnOpenFromDriveClicked" />
                <Label x:Name="FileLabel" Text="Файл не обрано" />

                <Label Text="Спосіб аналізу" FontAttributes="Bold" />
                <Picker x:Name="StrategyPicker" />

                <Label Text="Факультет" FontAttributes="Bold" />
                <Picker x:Name="FacultyPicker" />

                <Label Text="Кафедра" FontAttributes="Bold" />
                <Picker x:Name="DepartmentPicker" />

                <Label Text="Посада" FontAttributes="Bold" />
                <Picker x:Name="PositionPicker" />

                <Label Text="Ключове слово (П.І.П.)" FontAttributes="Bold" />
                <Entry x:Name="KeywordEntry" Placeholder="Наприклад, Коваленко" />

                <Button Text="Пошук" Clicked="OnSearchClicked" />
                <Button Text="Трансформувати в HTML" Clicked="OnTransformClicked" />
                <Button Text="Зберегти на Google Drive" Clicked="OnSaveToDriveClicked" />
                <Button Text="Clear" Clicked="OnClearClicked" />
                <Button Text="Відкрити протокол" Clicked="OnOpenLogClicked" />
                <Button Text="Вихід" Clicked="OnExitClicked" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Right panel: results -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
            <Label x:Name="ResultsLabel" Text="Результати" FontSize="18" FontAttributes="Bold" />

            <CollectionView Grid.Row="1" x:Name="ResultsView">
                <CollectionView.EmptyView>
                    <Label Text="Немає результатів" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Scientist">
                        <Border Padding="10" Margin="0,0,0,8" Stroke="LightGray">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding FullName}" FontAttributes="Bold" />
                                <Label Text="{Binding Position}" />
                                <Label Text="{Binding Faculty}" />
                                <Label Text="{Binding Department}" />
                                <Label Text="{Binding Laboratory, StringFormat='Лабораторія: {0}', TargetNullValue='Лабораторія: —'}" />
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding StartDate, StringFormat='з {0:dd.MM.yyyy}'}" />
                                    <Label Text="{Binding EndDate, StringFormat='по {0:dd.MM.yyyy}', TargetNullValue='по теперішній час'}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
